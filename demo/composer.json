{
	"repositories": [
		{
			"type": "composer",
			"url": "https://composer.typo3.org/"
		}
	],
	"require": {
		"typo3/cms-backend": "^13",
		"typo3/cms-core": "^13",
		"typo3/cms-extbase": "^13",
		"typo3/cms-extensionmanager": "^13",
		"typo3/cms-filelist": "^13",
		"typo3/cms-fluid": "^13",
		"typo3/cms-frontend": "^13",
		"typo3/cms-install": "^13",
		"typo3/cms-recordlist": "^13",

		"typo3/cms-belog": "^13",
		"typo3/cms-beuser": "^13",
		"typo3/cms-context-help": "^13",
		"typo3/cms-cshmanual": "^13",
		"typo3/cms-felogin": "^13",
		"typo3/cms-filemetadata": "^13",
		"typo3/cms-fluid-styled-content": "^13",
		"typo3/cms-form": "^13",
		"typo3/cms-info": "^13",
		"typo3/cms-info-pagetsconfig": "^13",
		"typo3/cms-linkvalidator": "^13",
		"typo3/cms-lowlevel": "^13",
		"typo3/cms-reports": "^13",
		"typo3/cms-scheduler": "^13",
		"typo3/cms-setup": "^13",
		"typo3/cms-t3editor": "^13",
		"typo3/cms-tstemplate": "^13",
		"typo3/cms-viewpage": "^13",

		"typo3/cms-seo": "^13",
		"typo3/cms-redirects": "^13",
		"typo3/cms-dashboard": "^13",

		"helhum/typo3-console": "^8.2",

		"typo3/cms-introduction": "^4.7",
		"bk2k/bootstrap-package": "^15.0"
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	},
	"extra": {
		"typo3/cms": {
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"web-dir": "web"
		}
	}
}
